---
interface Props {
  stage: string;
  size?: number;
}

const { stage, size = 18 } = Astro.props;
const stroke = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.6,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
} as const;
---

<span class={`stage-icon stage-icon--${stage}`} aria-hidden="true" style={`font-size:${size}px`}>
  {
    stage === 'limpiar' && (
      <svg viewBox="0 0 24 24" {...stroke}>
        <path d="M7 17h9a4 4 0 0 0 .6-7.96A5.5 5.5 0 0 0 6.2 10.4 3.8 3.8 0 0 0 7 17Z" />
        <line class="wipe" x1="3" y1="21" x2="21" y2="3" />
      </svg>
    )
  }
  {
    stage === 'mejorar' && (
      <svg viewBox="0 0 24 24" {...stroke}>
        <rect x="6" y="6" width="12" height="12" />
        <rect x="10" y="10" width="4" height="4" />
        <rect class="ring" x="3" y="3" width="18" height="18" />
      </svg>
    )
  }
  {
    stage === 'mover-y-guardar' && (
      <svg viewBox="0 0 24 24" {...stroke}>
        <path class="flow" d="M12 2.5v6M9 6l3 3 3-3" />
        <path d="M4 11h16v10H4z" />
        <path d="M4 11l1.5-3h13L20 11" />
      </svg>
    )
  }
  {
    stage === 'compartir' && (
      <svg viewBox="0 0 24 24" {...stroke}>
        <circle cx="12" cy="4.5" r="2" />
        <circle cx="4.5" cy="19" r="2" />
        <circle cx="19.5" cy="19" r="2" />
        <path class="flow" d="M11 6.3 5.6 17.2M13 6.3l5.4 10.9M6.5 19h11" />
      </svg>
    )
  }
  {
    stage === 'map' && (
      <svg viewBox="0 0 24 24" {...stroke}>
        <path d="M3 7.5 9 4.5l6 3 6-3v12l-6 3-6-3-6 3Z" />
        <path class="flow" d="M9 4.5v12M15 7.5v12" />
      </svg>
    )
  }
  {
    stage === 'usar' && (
      <svg viewBox="0 0 24 24" {...stroke}>
        <path d="M12 21.5s-6-5.3-6-10.2a6 6 0 1 1 12 0c0 4.9-6 10.2-6 10.2Z" />
        <circle cx="12" cy="11" r="2" />
        <circle class="ring" cx="12" cy="11" r="3.2" />
      </svg>
    )
  }
</span>
