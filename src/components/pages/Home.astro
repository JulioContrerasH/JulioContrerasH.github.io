---
import {
  chapterProjects,
  localizedField,
  localizedPath,
  profile,
  publications,
  research,
  t,
  type Lang,
} from '../../lib/content';
import Globe from '../Globe.astro';
import ProjectCard from '../ProjectCard.astro';
import PublicationList from '../PublicationList.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const bio = lang === 'es' ? profile.bio.es : profile.bio.en;
const chapters = [
  { id: 'peru', projects: chapterProjects('peru') },
  { id: 'valencia', projects: chapterProjects('valencia') },
  { id: 'ahora', projects: chapterProjects('ahora') },
] as const;
const featured = research.slice(0, 4);
const latest = publications.slice(0, 4);
const pick = (item: unknown, field: string) =>
  localizedField(lang, item as Record<string, unknown>, field);
const origin = pick(profile.location, 'origin');
const current = pick(profile.location, 'current');
---

<div class="stage">
  <Globe lang={lang} />
  <section class="hero">
    <div class="wrap">
      <div class="hero-inner">
        <img class="portrait" src={profile.photo} alt={profile.name} width="760" height="714" />
        <p class="eyebrow">
          {lang === 'es' ? `De ${origin} a ${current}` : `From ${origin} to ${current}`}
        </p>
        <h1>{profile.display_name}</h1>
        <p class="line">{T.hero.line}</p>
        <p class="sub">{bio}</p>
        <div class="actions">
          <a href={`mailto:${profile.email}`} aria-label={T.hero.email} title={T.hero.email}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3.5 7 8.5 6 8.5-6" />
            </svg>
          </a>
          <a href={localizedPath(lang, '/cv')} aria-label={T.hero.cv} title={T.hero.cv}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 3h8l4 4v14H6z" />
              <path d="M14 3v4h4M9 12h6M9 16h6" />
            </svg>
          </a>
          {profile.links.github && (
            <a href={profile.links.github} aria-label="GitHub" title="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3a9 9 0 0 0-2.85 17.54c.45.08.62-.2.62-.44v-1.7c-2.5.55-3.03-1.06-3.03-1.06-.41-1.04-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.07 1.38.93 1.38.93.8 1.38 2.11.98 2.62.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.93-2.42-.1-.23-.4-1.15.09-2.4 0 0 .75-.24 2.47.92a8.6 8.6 0 0 1 4.5 0c1.71-1.16 2.46-.92 2.46-.92.49 1.25.18 2.17.09 2.4.58.63.93 1.44.93 2.42 0 3.46-2.1 4.22-4.11 4.44.32.28.61.83.61 1.68v2.5c0 .24.16.52.62.43A9 9 0 0 0 12 3Z" />
              </svg>
            </a>
          )}
          {profile.links.scholar && (
            <a href={profile.links.scholar} aria-label="Google Scholar" title="Google Scholar">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 4 2 9l10 5 8-4v5h1V9L12 4Z" />
                <path d="M6 12.6V16c0 1.3 2.7 2.6 6 2.6s6-1.3 6-2.6v-3.4l-6 3-6-3Z" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="chapters">
    <div class="wrap">
      {
        chapters.map(({ id, projects: items }, index) => (
          <article class="chapter" id={`chapter-${id}`}>
            <div class="chapter-card">
              <p class="num">{String(index + 1).padStart(2, '0')}</p>
              <h2>{T.chapters[id].title}</h2>
              <p>{T.chapters[id].text}</p>
              <ul>
                {items.map((project) => (
                  <li>
                    <a href={`${localizedPath(lang, '/research')}#${project.id}`}>
                      {pick(project, 'title')}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</div>

<div class="solid" id="solid">
  <section class="section">
    <div class="wrap">
      <h2>{T.sections.research}</h2>
      <p class="intro">{T.sections.research_intro}</p>
      <div class="grid">
        {featured.map((project) => <ProjectCard project={project} lang={lang} />)}
      </div>
      <p style="margin-top: 20px">
        <a class="btn" href={localizedPath(lang, '/research')}>{T.labels.all_projects}</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{T.sections.publications}</h2>
      <p class="intro">{T.sections.publications_intro}</p>
      <PublicationList items={latest} lang={lang} />
      <p style="margin-top: 20px">
        <a class="btn" href={localizedPath(lang, '/publications')}>
          {T.labels.all_publications}
        </a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" id="contact">
      <h2>{T.sections.contact}</h2>
      <p class="intro">{T.sections.contact_text}</p>
      <p>
        <a class="btn" href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </div>
  </section>
</div>
