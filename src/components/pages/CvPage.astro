---
import { localizedField, profile, t, type Lang } from '../../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const T = t(lang);
const pick = (item: unknown, field: string) =>
  localizedField(lang, item as Record<string, unknown>, field);

const L = {
  profile: lang === 'es' ? 'Perfil' : 'Profile',
  experience: lang === 'es' ? 'Experiencia' : 'Experience',
  education: lang === 'es' ? 'Educación' : 'Education',
  skills: lang === 'es' ? 'Habilidades' : 'Skills',
  languages: lang === 'es' ? 'Idiomas' : 'Languages',
  diplomas: lang === 'es' ? 'Diplomas' : 'Diplomas',
  interests: lang === 'es' ? 'Intereses' : 'Interests',
};

const bio = lang === 'es' ? profile.bio.es : profile.bio.en;
const interests = lang === 'es' ? profile.interests.es : profile.interests.en;
const nameParts = profile.name.split(' ');
const nameBreak = Math.ceil(nameParts.length / 2);
const nameFirst = nameParts.slice(0, nameBreak).join(' ');
const nameLast = nameParts.slice(nameBreak).join(' ');

const contacts = [
  { icon: 'mail', label: profile.email, href: `mailto:${profile.email}` },
  { icon: 'web', label: 'ISP · Universitat de València', href: profile.links.isp },
  { icon: 'github', label: 'GitHub', href: profile.links.github },
  { icon: 'linkedin', label: 'LinkedIn', href: profile.links.linkedin },
  { icon: 'orcid', label: 'ORCID', href: profile.links.orcid },
  { icon: 'scholar', label: 'Google Scholar', href: profile.links.scholar },
  {
    icon: 'pin',
    label: `${pick(profile.location, 'current')} · ${pick(profile.location, 'origin')}`,
    href: null,
  },
].filter((item) => item.href || item.icon === 'pin');
---

<section class="section">
  <div class="wrap">
    <div class="cv-sheet">
      <div class="cv-main">
        <h1 class="cv-name">
          <span>{nameFirst}</span>
          <span>{nameLast}</span>
        </h1>

        <section class="cv-section">
          <h2>{L.profile}</h2>
          <p class="cv-profile">{bio}</p>
        </section>

        <section class="cv-section">
          <h2>{L.experience}</h2>
          {
            profile.experience.map((item) => (
              <div class="cv-item">
                <div class="org">
                  <span class="role">{pick(item, 'role')}</span>
                  {item.dates && <span class="dates">{item.dates}</span>}
                </div>
                <div class="org">
                  <span class="place">{item.org}</span>
                </div>
                {item.details && <p class="cv-detail">{pick(item, 'details')}</p>}
              </div>
            ))
          }
        </section>

        <section class="cv-section">
          <h2>{L.education}</h2>
          {
            profile.education.map((item) => (
              <div class="cv-item">
                <div class="org">
                  <span class="role">{pick(item, 'degree')}</span>
                  {item.dates && <span class="dates">{item.dates}</span>}
                </div>
                <div class="org">
                  <span class="place">{item.org}</span>
                </div>
                {item.details && <p class="cv-detail">{pick(item, 'details')}</p>}
              </div>
            ))
          }
        </section>

        <section class="cv-section">
          <h2>{L.interests}</h2>
          <p class="cv-detail">{interests.join(' · ')}</p>
        </section>
      </div>

      <aside class="cv-aside">
        <img
          class="cv-photo"
          src="/assets/img/julio-photo.jpg"
          alt={profile.name}
          width="152"
          height="152"
        />

        <ul class="cv-contact">
          {
            contacts.map((item) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  {item.icon === 'mail' && (
                    <>
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="m3.5 7 8.5 6 8.5-6" />
                    </>
                  )}
                  {item.icon === 'github' && (
                    <path d="M12 3a9 9 0 0 0-2.85 17.54c.45.08.62-.2.62-.44v-1.7c-2.5.55-3.03-1.06-3.03-1.06-.41-1.04-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.07 1.38.93 1.38.93.8 1.38 2.11.98 2.62.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.93-2.42-.1-.23-.4-1.15.09-2.4 0 0 .75-.24 2.47.92a8.6 8.6 0 0 1 4.5 0c1.71-1.16 2.46-.92 2.46-.92.49 1.25.18 2.17.09 2.4.58.63.93 1.44.93 2.42 0 3.46-2.1 4.22-4.11 4.44.32.28.61.83.61 1.68v2.5c0 .24.16.52.62.43A9 9 0 0 0 12 3Z" />
                  )}
                  {item.icon === 'linkedin' && (
                    <path d="M4.98 3.5A2 2 0 1 1 5 7.5a2 2 0 0 1-.02-4ZM3.5 9h3v11h-3V9Zm5.5 0h2.9v1.5h.04c.4-.76 1.4-1.56 2.86-1.56 3.06 0 3.7 2 3.7 4.7V20h-3v-5.6c0-1.34-.03-3.06-1.9-3.06-1.85 0-2.1 1.44-2.1 2.96V20H9V9Z" />
                  )}
                  {item.icon === 'orcid' && (
                    <>
                      <circle cx="12" cy="12" r="9" />
                      <path d="M8.6 9.2v6.4M8.6 7.3v.1M12 9.2h1.7a3.2 3.2 0 0 1 0 6.4H12V9.2Z" />
                    </>
                  )}
                  {item.icon === 'scholar' && (
                    <path d="M12 4 2 9l10 5 8-4v5h1V9L12 4Zm-6 8.6V16c0 1.3 2.7 2.6 6 2.6s6-1.3 6-2.6v-3.4l-6 3-6-3Z" />
                  )}
                  {item.icon === 'web' && (
                    <>
                      <circle cx="12" cy="12" r="9" />
                      <path d="M3.5 9.5h17M3.5 14.5h17M12 3a14.5 14.5 0 0 1 0 18M12 3a14.5 14.5 0 0 0 0 18" />
                    </>
                  )}
                  {item.icon === 'pin' && (
                    <>
                      <path d="M12 21s-6-5.2-6-10a6 6 0 1 1 12 0c0 4.8-6 10-6 10Z" />
                      <circle cx="12" cy="11" r="2" />
                    </>
                  )}
                </svg>
                {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
              </li>
            ))
          }
        </ul>

        <section class="cv-section">
          <h2>{L.skills}</h2>
          {
            profile.skills.map((group) => (
              <div class="cv-skill">
                <div class="family">{group.family}</div>
                <div class="cv-detail">{group.items.join(', ')}</div>
              </div>
            ))
          }
        </section>

        <section class="cv-section">
          <h2>{L.languages}</h2>
          {
            profile.languages.map((language) => (
              <div class="cv-skill">
                <div class="family">{language.name}</div>
                <div class="cv-detail">{language.level}</div>
              </div>
            ))
          }
        </section>

        <section class="cv-section">
          <h2>{L.diplomas}</h2>
          {
            profile.certificates.map((certificate) => (
              <div class="cv-skill">
                <div class="family">
                  {certificate.url ? (
                    <a href={certificate.url} target="_blank" rel="noopener">
                      {certificate.name}
                    </a>
                  ) : (
                    certificate.name
                  )}
                </div>
                <div class="cv-detail">{certificate.year}</div>
              </div>
            ))
          }
        </section>
      </aside>
    </div>
  </div>
</section>
