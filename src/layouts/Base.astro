---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../lib/content';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const T = t(lang);
const pageTitle = title ? `${title} · ${T.site.title}` : T.site.title;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={T.site.description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (dark ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const header = document.querySelector('.header');
      const solid = document.querySelector('#solid');
      if (header && solid) {
        const check = () => {
          const top = solid.getBoundingClientRect().top;
          header.classList.toggle('on-dark', top > 64);
        };
        check();
        addEventListener('scroll', check, { passive: true });
        addEventListener('resize', check, { passive: true });
      }
    </script>
  </body>
</html>
