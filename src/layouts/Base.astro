---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../lib/content';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const T = t(lang);
const pageTitle = title ? `${title} · ${T.site.title}` : T.site.title;
const path = Astro.url.pathname;
const urlEs = lang === 'es' ? path : path === '/' ? '/es/' : `/es${path}`;
const urlEn = lang === 'en' ? path : path.replace(/^\/es/, '') || '/';
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={T.site.description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(urlEn, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(urlEs, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(urlEn, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={T.site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/img/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={T.site.description} />
    <meta name="twitter:image" content={new URL('/assets/img/og.png', Astro.site)} />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (dark ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const header = document.querySelector('.header');
      const solid = document.querySelector('#solid');
      if (header) {
        const checkSolid = () => {
          if (!solid) return;
          const top = solid.getBoundingClientRect().top;
          header.classList.toggle('on-dark', top > 64);
        };
        const checkScrolled = () => {
          header.classList.toggle('scrolled', window.scrollY > 8);
        };
        checkSolid();
        checkScrolled();
        addEventListener(
          'scroll',
          () => {
            checkSolid();
            checkScrolled();
          },
          { passive: true }
        );
        addEventListener('resize', checkSolid, { passive: true });
      }
    </script>
  </body>
</html>
