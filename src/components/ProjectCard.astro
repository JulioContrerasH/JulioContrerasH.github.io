---
import { linkLabel, localizedField, t, type Lang, type Project } from '../lib/content';
import StageIcon from './StageIcon.astro';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const T = t(lang);
const links = Object.entries(project.links ?? {});
const pick = (field: string) =>
  localizedField(lang, project as unknown as Record<string, unknown>, field);
const title = pick('title');
const oneLiner = pick('one_liner');
const location = pick('location');
---

<article class="card" id={project.id}>
  {
    project.image ? (
      <img class="thumb" src={project.image} alt={title} loading="lazy" />
    ) : (
      <div class="thumb placeholder" aria-hidden="true">
        <StageIcon stage="map" size={72} />
      </div>
    )
  }
  <div class="body">
    <h3>
      {title}
      {project.year && <span class="year">· {project.year}</span>}
    </h3>
    <div class="meta">
      {location && <span class="chip">{location}</span>}
    </div>
    <p>{oneLiner}</p>
    {
      links.length > 0 && (
        <div class="links">
        {links.map(([key, href]) => (
          <a href={href} target="_blank" rel="noopener">
            {linkLabel(lang, key)}
          </a>
        ))}
        </div>
      )
    }
  </div>
</article>
